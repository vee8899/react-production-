# Browser-safe Supabase configuration.
# Copy this file to .env.local and replace the placeholders.
# Never put service-role keys, webhook secrets, admin secrets, or n8n API keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional browser analytics. The PostHog project token is public by design.
# Do not put private API keys here.
VITE_POSTHOG_PROJECT_TOKEN=phc_your-project-token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional browser error reporting. The Sentry DSN is public by design.
VITE_SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/000000
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Server-side multi-agent configuration (agents/). Never expose these to the browser.
# Copy these keys into .env.local (gitignored); the agents library loads it automatically.
# Each role is "provider/model-id". Supported providers: anthropic, deepseek.
# ORCHESTRATOR_MODEL=anthropic/claude-opus-4-8
# CODING_MODEL=deepseek/deepseek-v4-flash
# REVIEWER_MODEL=anthropic/claude-opus-4-8
# ANTHROPIC_API_KEY=your-anthropic-key
# DEEPSEEK_API_KEY=your-deepseek-key
# ANTHROPIC_BASE_URL=optional-custom-anthropic-endpoint
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AGENTS_MAX_ATTEMPTS=2
