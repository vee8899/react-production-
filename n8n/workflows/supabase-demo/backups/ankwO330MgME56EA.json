      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select id, organization_id, first_name, last_name, email, phone, status, source_system, external_id, metadata, updated_at from real_estate.leads where status in ('new','contacted','nurture') and updated_at <= now() - interval '1 day' order by updated_at asc limit 100"
      },
      "credentials": {
        "postgres": {
          "id": "9NYei4dh7z08Xyf4",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "ba3bae20-513c-445f-a9c8-dd5af290828d",
      "name": "Annotate Follow-up Queue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "feature_type",
              "name": "feature_type",
              "value": "lead_follow_up",
              "type": "string"
            },
            {
              "id": "queue_action",
              "name": "queue_action",
              "value": "follow_up_required",
              "type": "string"
            },
            {
              "id": "queued_at",
              "name": "queued_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    }
