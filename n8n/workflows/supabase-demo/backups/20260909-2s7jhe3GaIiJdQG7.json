      "parameters": {
        "operation": "executeQuery",
        "query": "select organization_id, count(*) filter (where entity = 'lead') as lead_count, count(*) filter (where entity = 'listing') as listing_count, count(*) filter (where entity = 'appointment') as appointment_count from (select organization_id, 'lead' as entity from real_estate.leads union all select organization_id, 'listing' as entity from real_estate.listings union all select organization_id, 'appointment' as entity from real_estate.appointments) entities group by organization_id order by organization_id"
      },
