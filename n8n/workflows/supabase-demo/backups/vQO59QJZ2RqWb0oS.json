  "nodes": [
    {
      "id": "683f330d-2d1c-4a89-879b-37a3bb265325",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "5b04dd3b-8530-4789-92fb-ea3e5013c9e7",
      "name": "Find Listing Notification Candidates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select id, organization_id, listing_type, status, address_line1, city, state_region, postal_code, property_type, price, bedrooms, bathrooms, listing_url, source_system, external_id, metadata, updated_at from real_estate.listings where status = 'active' and updated_at >= now() - interval '15 minutes' order by updated_at asc limit 100"
      },
      "credentials": {
        "postgres": {
          "id": "9NYei4dh7z08Xyf4",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "4f5cd276-2679-4268-9de0-ec5ae21c5efe",
      "name": "Annotate Listing Notification Queue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "feature_type",
              "name": "feature_type",
              "value": "listing_notifications",
              "type": "string"
            },
            {
              "id": "queue_action",
              "name": "queue_action",
              "value": "listing_notification_required",
              "type": "string"
            },
            {
              "id": "queued_at",
              "name": "queued_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
