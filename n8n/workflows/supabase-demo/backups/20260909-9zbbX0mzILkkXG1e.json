      "typeVersion": 2.6,
      "position": [
        448,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.ingest_automation_run($1::text,$2::uuid,$3::public.feature_type,$4::text,$5::text,$6::public.run_status,now(),$7::integer,$8::integer,$9::integer,$10::text,$11::uuid,$12::jsonb,$13::jsonb) as run_id",
        "options": {
          "queryReplacement": "={{ $json.event_id }},={{ $json.client_id }},={{ $json.feature_type }},={{ $json.workflow_name }},={{ $json.n8n_workflow_id }},={{ $json.status }},={{ $json.duration_ms }},={{ $json.records_processed }},={{ $json.records_failed }},={{ $json.error_message }},={{ $json.workflow_id }},={{ JSON.stringify($json.metadata) }},={{ JSON.stringify($json.entity_refs) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "9NYei4dh7z08Xyf4",
          "name": "Postgres account"
        }
      }
